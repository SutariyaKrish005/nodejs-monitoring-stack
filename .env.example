# ─── Application ──────────────────────────────────────────────────────────────────
# Port the Express server listens on inside the container
PORT=3000

# Node environment: development | production | test
NODE_ENV=production

# ─── MongoDB ──────────────────────────────────────────────────────────────────────
# Connection string — "mongodb" resolves to the MongoDB container via Docker DNS.
# Format: mongodb://<host>:<port>/<database>
MONGODB_URI=mongodb://mongodb:27017/mydb

# ─── Grafana (set in docker-compose.yml, listed here for reference) ───────────────
# GF_SECURITY_ADMIN_USER=admin
# GF_SECURITY_ADMIN_PASSWORD=admin
